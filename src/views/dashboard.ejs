<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="LedgerGuard Banking Transaction Integrity & Immutability Demonstration Dashboard">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- App Header -->
  <header class="app-header">
    <div class="header-container">
      <div class="brand-section">
        <div class="brand-logo" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <h1 class="brand-title">LedgerGuard</h1>
          <div class="brand-subtitle">Banking Transaction Integrity &amp; Immutability System</div>
        </div>
      </div>

      <div class="header-actions">
        <div class="env-pill">
          <span class="health-dot" title="Local Server Online"></span>
          <span>LOCAL DEMO ENVIRONMENT</span>
        </div>
        <button id="btnRefreshAll" class="btn btn-secondary btn-sm" title="Refresh all balances and audit streams">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6"></path><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          Refresh All
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Wrapper -->
  <main class="main-wrapper">

    <!-- Stat Metrics Row -->
    <section class="stats-grid" aria-label="System Metrics Overview">
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Total Accounts</span>
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
        </div>
        <div class="stat-value" id="statTotalAccounts">—</div>
        <div class="stat-meta">Active checking &amp; savings accounts</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Total Ledger Liquidity</span>
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
        </div>
        <div class="stat-value" id="statTotalLiquidity">—</div>
        <div class="stat-meta">Sum of all ledger-derived balances</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Transactions Recorded</span>
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          </div>
        </div>
        <div class="stat-value" id="statTotalTransactions">—</div>
        <div class="stat-meta">ACID-guaranteed journal records</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-label">Ledger Integrity Status</span>
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
        </div>
        <div style="margin-top: 0.35rem;">
          <span id="statReconBadge" class="badge badge-emerald">Auditing...</span>
        </div>
        <div class="stat-meta">Automated double-entry reconciliation</div>
      </div>
    </section>

    <!-- Two-Column Interactive Dashboard Layout -->
    <div class="dashboard-grid">

      <!-- Left Column: Accounts & History -->
      <div class="panel-column">

        <!-- Panel 1: Accounts & Balances -->
        <section class="panel" aria-labelledby="accounts-heading">
          <div class="panel-header">
            <div>
              <h2 id="accounts-heading" class="panel-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                Accounts &amp; Ledger-Derived Balances
              </h2>
              <div class="panel-subtitle">Balances calculated exclusively via double-entry journal entries</div>
            </div>
            <div class="panel-controls">
              <input type="text" id="accountFilter" class="form-input" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; width: 170px;" placeholder="Filter accounts...">
            </div>
          </div>
          <div class="panel-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Account ID</th>
                    <th>Holder / Details</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Ledger Balance</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="accountsTableBody">
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                      <span class="spinner"></span> Loading accounts from PostgreSQL...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Panel 2: Recent Transactions -->
        <section class="panel" aria-labelledby="transactions-heading">
          <div class="panel-header">
            <div>
              <h2 id="transactions-heading" class="panel-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Recent Transaction Audit Trail
              </h2>
              <div class="panel-subtitle">Latest immutable transactions recorded in the journal</div>
            </div>
          </div>
          <div class="panel-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Tx ID</th>
                    <th>Timestamp</th>
                    <th>Type</th>
                    <th>Route</th>
                    <th>Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="transactionsTableBody">
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                      <span class="spinner"></span> Loading transaction history...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

      </div>

      <!-- Right Column: Interactive Simulator & Reconciliation -->
      <div class="panel-column">

        <!-- Panel 3: Transfer Execution Simulator -->
        <section class="panel" aria-labelledby="simulator-heading">
          <div class="panel-header">
            <div>
              <h2 id="simulator-heading" class="panel-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                Transfer Execution Simulator
              </h2>
              <div class="panel-subtitle">POST /transfers with Idempotency-Key validation &amp; ACID protection</div>
            </div>
          </div>
          <div class="panel-body">

            <form id="transferForm" novalidate>

              <!-- Idempotency Key Control Group -->
              <div class="form-group">
                <label class="form-label" for="idempotencyKey">
                  <span>Idempotency-Key Header</span>
                  <span class="form-label-hint">Required for all transfers</span>
                </label>
                <div class="input-with-button">
                  <input type="text" id="idempotencyKey" class="form-input font-mono" style="font-size: 0.8rem;" required>
                  <button type="button" id="btnNewKey" class="btn btn-secondary btn-sm" title="Generate fresh UUID">New Key</button>
                </div>
                <!-- Interactive Idempotency Test Triggers -->
                <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap;">
                  <button type="button" id="btnReplayTest" class="btn btn-secondary btn-sm" style="font-size: 0.7rem;" title="Test identical retry: should return HTTP 200 with replayed=true">
                    ⚡ Test Replay (Same Key)
                  </button>
                  <button type="button" id="btnConflictTest" class="btn btn-secondary btn-sm" style="font-size: 0.7rem;" title="Test conflict: mutates amount with same key, expecting HTTP 409">
                    ⚠️ Test Conflict (Mutate Payload)
                  </button>
                </div>
                <div id="simulatorQuickNote" style="font-size: 0.7rem; color: var(--accent-indigo); margin-top: 0.35rem; transition: opacity 0.3s; opacity: 0;"></div>
              </div>

              <!-- Source Account -->
              <div class="form-group">
                <label class="form-label" for="sourceAccountId">Source Account (Debit)</label>
                <select id="sourceAccountId" class="form-select" required>
                  <option value="">Loading accounts...</option>
                </select>
              </div>

              <!-- Swap Button -->
              <div style="display: flex; justify-content: center; margin: -0.4rem 0 0.7rem;">
                <button type="button" id="btnSwapAccounts" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.6rem; font-size: 0.7rem;" title="Swap Source and Destination">
                  ⇅ Swap Accounts
                </button>
              </div>

              <!-- Destination Account -->
              <div class="form-group">
                <label class="form-label" for="destinationAccountId">Destination Account (Credit)</label>
                <select id="destinationAccountId" class="form-select" required>
                  <option value="">Loading accounts...</option>
                </select>
              </div>

              <!-- Amount & Currency -->
              <div class="form-group">
                <label class="form-label" for="transferAmount">
                  <span>Transfer Amount</span>
                  <span class="form-label-hint">Exact NUMERIC(20,4)</span>
                </label>
                <div class="input-with-button">
                  <input type="number" id="transferAmount" class="form-input font-mono" step="0.0001" min="0.0001" placeholder="e.g. 50.0000" value="50.0000" required>
                  <span style="display: flex; align-items: center; padding: 0 0.85rem; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-md); font-weight: 600; font-size: 0.8rem; color: var(--text-secondary);">INR</span>
                </div>
              </div>

              <!-- Description -->
              <div class="form-group">
                <label class="form-label" for="transferDesc">
                  <span>Memo / Description</span>
                  <span class="form-label-hint">Optional</span>
                </label>
                <input type="text" id="transferDesc" class="form-input" placeholder="e.g. Interbank settlement transfer">
              </div>

              <!-- Submit Button -->
              <button type="submit" id="btnSubmitTransfer" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Execute Atomic Transfer
              </button>

            </form>

            <!-- Simulator Feedback Area -->
            <div id="simulatorFeedback" aria-live="polite"></div>

          </div>
        </section>

        <!-- Panel 4: Reconciliation Report -->
        <section class="panel" aria-labelledby="recon-heading">
          <div class="panel-header">
            <div>
              <h2 id="recon-heading" class="panel-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Ledger Reconciliation Engine
              </h2>
              <div class="panel-subtitle">Read-only audit comparing transaction journal to ledger postings</div>
            </div>
            <div class="panel-controls">
              <button id="btnRunReconciliation" class="btn btn-secondary btn-sm" title="Execute full reconciliation check now">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"></path><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                Re-Audit Ledger
              </button>
            </div>
          </div>
          <div class="panel-body">

            <div id="reconCard" class="recon-card">
              <div class="recon-status-row">
                <div id="reconStatusBadge" class="recon-status-badge">
                  <span style="color: var(--text-muted);">Auditing ledger postings...</span>
                </div>
              </div>

              <div class="recon-metrics-grid">
                <div class="recon-metric-item">
                  <div class="recon-metric-label">Completed Tx</div>
                  <div class="recon-metric-val" id="reconMetricTransactions">—</div>
                </div>
                <div class="recon-metric-item">
                  <div class="recon-metric-label">Valid Journal Tx</div>
                  <div class="recon-metric-val" id="reconMetricValid">—</div>
                </div>
                <div class="recon-metric-item">
                  <div class="recon-metric-label">Discrepancies</div>
                  <div class="recon-metric-val" id="reconMetricDiscrepancies">0</div>
                </div>
              </div>

              <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem;">
                Double-Entry Status: <span id="reconMetricDelta" class="font-mono" style="font-weight: 600; color: #fff;">Balanced (Zero Imbalance)</span>
              </div>
            </div>

            <!-- Discrepancy Breakdown Section -->
            <div id="reconDetailsContainer">
              <div style="font-size: 0.775rem; color: var(--text-muted); text-align: center; padding: 0.75rem;">
                Fetching real-time reconciliation findings...
              </div>
            </div>

          </div>
        </section>

      </div>

    </div>

    <!-- App Footer -->
    <footer class="app-footer">
      <div>
        <span>LedgerGuard Banking Transaction Integrity System &mdash; Local PostgreSQL Demonstration</span>
      </div>
      <div class="footer-badge">
        <span class="badge badge-muted">Zero External Runtime Dependencies</span>
      </div>
    </footer>

  </main>

  <!-- Ledger Postings Modal -->
  <div id="ledgerModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="ledgerModalTitle">
    <div class="modal-container">
      <div class="modal-header">
        <h3 id="ledgerModalTitle" style="font-size: 0.95rem; font-weight: 600;">Account Ledger Postings</h3>
        <button id="btnCloseModal" class="btn-icon" aria-label="Close modal">&times;</button>
      </div>
      <div id="ledgerModalBody" class="modal-body">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
